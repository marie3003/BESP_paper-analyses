<!-- Coalescent tree simulation under bottleneck model. -->
<beast version="2.0"
       namespace="beast.base.inference.parameter:remaster
                  :beast.base.evolution.tree.coalescent
                  :feast.popmodels">
  <run spec="Simulator" nSims="{$nreplicates}">
    <simulate id="tree" spec="SimulatedTree">
      <trajectory id="traj" spec="CoalescentTrajectory" maxTrajLogAge="10" loggingGridSize="1000">
        <population id="pop" spec="CompoundPopulationModel" changeTimes="20.0 23.0">
          <populationModel spec="ConstantPopulation" popSize="1000.0"/>
          <populationModel spec="ConstantPopulation" popSize="100.0"/>
          <populationModel spec="ConstantPopulation" popSize="1000.0"/>
        </population>
        <reaction spec="PunctualReaction" n="250" times="0">0 -> pop</reaction>
      </trajectory>
    </simulate>

    <logger fileName="{$filebase}/independenthomochronous/bottleneck/bottleneck.trees" mode="tree">
      <log spec="TypedTreeLogger" tree="@tree"/>
    </logger>

    <logger fileName="{$filebase}/independenthomochronous/bottleneck/bottleneck.traj" log="@traj"/>
  </run>
</beast>